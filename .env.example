# Bybit API (opsional, bisa kosong untuk data public)
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Trading Configuration
MAX_RISK_PERCENT=1.0
BALANCE_USD=1000
MAX_LEVERAGE=10
MAX_OPEN_POSITIONS=20

# Gemini AI API Keys (Multiple keys for rotation to avoid rate limits)
# Get your API keys from: https://aistudio.google.com/app/apikey
# Separate multiple keys with commas for automatic rotation
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2,your_gemini_api_key_3

# Gemini AI Configuration
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=500
